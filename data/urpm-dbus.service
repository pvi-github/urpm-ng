[Unit]
Description=urpm Package Management D-Bus Service
Documentation=man:urpm(1)
After=dbus.service

[Service]
Type=dbus
BusName=org.mageia.Urpm.v1
ExecStart=/usr/libexec/urpm-dbus-service

# No sandboxing: a package manager runs rpm scriptlets as root, so any
# of it would be decorative.  ProtectHome=yes was the last one left and
# it broke a real case, a file:// medium under a user's home.
PrivateTmp=no
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
